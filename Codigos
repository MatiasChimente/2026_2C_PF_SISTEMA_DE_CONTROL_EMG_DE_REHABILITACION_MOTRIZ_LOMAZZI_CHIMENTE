#include <BLEDevice.h>
#include <BLEServer.h>
#include <BLEUtils.h>
#include <BLE2902.h>
#include <WiFi.h>
#include <esp_now.h>
#include <esp_wifi.h>

/* ══════════════════════════════════════════════════════════
   ROBRAIN KIDS — SENSOR EMG BRAZO DERECHO (ESP32-C3 SUPER MINI)
   - Detector de envolvente pico a pico para señal EMG real
   - Umbral por defecto 800 (ajustable via SET_TH desde la web)
   - BLE GATT Server para Web + ESP-NOW Directo al auto
══════════════════════════════════════════════════════════ */

#define DEVICE_NAME         "Robrain-EMG-R"
#define SERVICE_UUID        "4fafc201-1fb5-459e-8fcc-c5c9c331914b"
#define CHARACTERISTIC_UUID "beb5483e-36e1-4688-b7f5-ea07361b26a8"

#define PIN_EMG      0
#define WIFI_CHANNEL 1

typedef struct __attribute__((packed)) struct_emg_msg {
  char arm;
  uint8_t active;
  uint16_t raw;
  uint32_t seq;
} struct_emg_msg;

struct_emg_msg emgData;
uint8_t broadcastAddress[] = {0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF};

BLEServer* pServer = NULL;
BLECharacteristic* pCharacteristic = NULL;
bool deviceConnected = false;
bool oldDeviceConnected = false;

int threshold = 800;        // Bajado de 1500 a 800 — compatible con el nuevo algoritmo
bool autoModeEnabled = false;
uint32_t packetSeq = 0;

float filteredValue = 0.0;
const float filterAlpha = 0.35;

unsigned long lastEspNowSend = 0;
unsigned long lastBleNotify = 0;

class ServerCallbacks: public BLEServerCallbacks {
  void onConnect(BLEServer* pServer) {
    deviceConnected = true;
    Serial.println("[BLE] Web conectada a Brazo Derecho");
  }
  void onDisconnect(BLEServer* pServer) {
    deviceConnected = false;
    Serial.println("[BLE] Web desconectada");
  }
};

class CharCallbacks: public BLECharacteristicCallbacks {
  void onWrite(BLECharacteristic *pChar) {
    String rxValue = pChar->getValue().c_str();
    if (rxValue.length() > 0) {
      if (rxValue.startsWith("SET_TH:")) {
        threshold = rxValue.substring(7).toInt();
        Serial.printf("[CONFIG] Nuevo umbral Derecho: %d\n", threshold);
      }
      else if (rxValue == "MODE:AUTO") {
        autoModeEnabled = true;
        Serial.println("[MODO] Activado MODO AUTO (ESP-NOW)");
      }
      else if (rxValue == "MODE:GAMES") {
        autoModeEnabled = false;
        Serial.println("[MODO] Activado MODO JUEGOS");
      }
    }
  }
};

void setup() {
  Serial.begin(115200);
  analogReadResolution(12);
  pinMode(PIN_EMG, INPUT);

  // Inicializar filtro con valor real del ADC para evitar arranque falso
  filteredValue = analogRead(PIN_EMG);

  // 1. Configuración Wi-Fi optimizada para ESP32-C3 Super Mini
  WiFi.mode(WIFI_STA);
  WiFi.disconnect();
  WiFi.setTxPower(WIFI_POWER_11dBm);

  esp_wifi_set_promiscuous(true);
  esp_wifi_set_channel(WIFI_CHANNEL, WIFI_SECOND_CHAN_NONE);
  esp_wifi_set_promiscuous(false);

  // Inicializar ESP-NOW
  if (esp_now_init() == ESP_OK) {
    Serial.println("[ESP-NOW] Inicializado en Canal 1");
    esp_now_peer_info_t peerInfo = {};
    memcpy(peerInfo.peer_addr, broadcastAddress, 6);
    peerInfo.channel = WIFI_CHANNEL;
    peerInfo.encrypt = false;
    if (esp_now_add_peer(&peerInfo) != ESP_OK) {
      Serial.println("[ESP-NOW] Error al agregar peer broadcast");
    }
  }

  // 2. Inicializar BLE
  BLEDevice::init(DEVICE_NAME);
  pServer = BLEDevice::createServer();
  pServer->setCallbacks(new ServerCallbacks());

  BLEService *pService = pServer->createService(SERVICE_UUID);
  pCharacteristic = pService->createCharacteristic(
    CHARACTERISTIC_UUID,
    BLECharacteristic::PROPERTY_READ   |
    BLECharacteristic::PROPERTY_WRITE  |
    BLECharacteristic::PROPERTY_WRITE_NR |
    BLECharacteristic::PROPERTY_NOTIFY
  );
  pCharacteristic->addDescriptor(new BLE2902());
  pCharacteristic->setCallbacks(new CharCallbacks());
  pService->start();

  BLEAdvertising *pAdvertising = BLEDevice::getAdvertising();
  pAdvertising->addServiceUUID(SERVICE_UUID);
  pAdvertising->setScanResponse(true);
  pAdvertising->setMinPreferred(0x06);
  BLEDevice::startAdvertising();

  Serial.println("[STATUS] Robrain-EMG-R con algoritmo pico a pico listo.");
}

void loop() {
  if (!deviceConnected && oldDeviceConnected) {
    delay(200);
    pServer->startAdvertising();
    oldDeviceConnected = deviceConnected;
  }
  if (deviceConnected && !oldDeviceConnected) {
    oldDeviceConnected = deviceConnected;
  }

  // 1. RÁFAGA RÁPIDA: 30 muestras para detectar la oscilación muscular real
  int minVal = 4095;
  int maxVal = 0;
  for (int i = 0; i < 20; i++) {
    int sample = analogRead(PIN_EMG);
    if (sample < minVal) minVal = sample;
    if (sample > maxVal) maxVal = sample;
    delayMicroseconds(250); // Muestreo a ~4 kHz
  }

  // 2. Amplitud pico a pico — elimina la línea base y mide la fuerza real
  int amplitud = maxVal - minVal;

  // 3. Ganancia digital — amplifica para tener rango claro 0-3000
  int gananciaDigital = 4;
  int fuerzaCalculada = amplitud * gananciaDigital;

  // 4. Suavizado con filtro de media móvil
  filteredValue = (filterAlpha * fuerzaCalculada) + ((1.0 - filterAlpha) * filteredValue);
  uint16_t cleanValue = (uint16_t)filteredValue;
  bool isContracted = (cleanValue >= threshold);

  // 5. Notificación BLE (25 Hz)
  if (deviceConnected && (millis() - lastBleNotify >= 40)) {
    lastBleNotify = millis();
    char strVal[12];
    sprintf(strVal, "%d", cleanValue);
    pCharacteristic->setValue(strVal);
    pCharacteristic->notify();
  }

  // 6. Transmisión ESP-NOW al auto (35 Hz)
  if (autoModeEnabled && (millis() - lastEspNowSend >= 28)) {
    lastEspNowSend = millis();
    emgData.arm    = 'R';
    emgData.active = isContracted ? 1 : 0;
    emgData.raw    = cleanValue;
    emgData.seq    = packetSeq++;
    esp_now_send(broadcastAddress, (uint8_t *)&emgData, sizeof(emgData));

    Serial.printf("[EMG-R] Amplitud:%d Fuerza:%d Umbral:%d Activo:%d\n",
                  amplitud, cleanValue, threshold, emgData.active);
  }

  delay(5);
}






