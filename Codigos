<script>
/* ══════════════════════════════════════════════════════════
   SISTEMA DE AUDIO SINTETIZADO (Web Audio API)
══════════════════════════════════════════════════════════ */
let audioCtx = null;
function initAudio() {
  if (!audioCtx) {
    audioCtx = new (window.AudioContext || window.webkitAudioContext)();
  }
}

function playSound(type) {
  try {
    initAudio();
    if (audioCtx.state === 'suspended') audioCtx.resume();
    const now = audioCtx.currentTime;

    if (type === 'pop') {
      const osc = audioCtx.createOscillator();
      const gain = audioCtx.createGain();
      osc.type = 'sine';
      osc.frequency.setValueAtTime(400, now);
      osc.frequency.exponentialRampToValueAtTime(800, now + 0.1);
      gain.gain.setValueAtTime(0.3, now);
      gain.gain.exponentialRampToValueAtTime(0.01, now + 0.1);
      osc.connect(gain); gain.connect(audioCtx.destination);
      osc.start(now); osc.stop(now + 0.1);
    } 
    else if (type === 'hit') {
      const osc = audioCtx.createOscillator();
      const gain = audioCtx.createGain();
      osc.type = 'triangle';
      osc.frequency.setValueAtTime(520, now);
      osc.frequency.exponentialRampToValueAtTime(320, now + 0.15);
      gain.gain.setValueAtTime(0.4, now);
      gain.gain.exponentialRampToValueAtTime(0.01, now + 0.15);
      osc.connect(gain); gain.connect(audioCtx.destination);
      osc.start(now); osc.stop(now + 0.15);
    }
    else if (type === 'coin') {
      const osc = audioCtx.createOscillator();
      const gain = audioCtx.createGain();
      osc.type = 'sine';
      osc.frequency.setValueAtTime(987, now);
      osc.frequency.setValueAtTime(1318, now + 0.08);
      gain.gain.setValueAtTime(0.25, now);
      gain.gain.exponentialRampToValueAtTime(0.01, now + 0.25);
      osc.connect(gain); gain.connect(audioCtx.destination);
      osc.start(now); osc.stop(now + 0.25);
    }
    else if (type === 'noteL') { playTone(261.63, 0.2); } // C4
    else if (type === 'noteBoth') { playTone(329.63, 0.2); } // E4
    else if (type === 'noteR') { playTone(392.00, 0.2); } // G4
    else if (type === 'win') {
      [261, 329, 392, 523].forEach((f, i) => {
        setTimeout(() => playTone(f, 0.15), i * 100);
      });
    }
  } catch(e) {}
}

function playTone(freq, dur) {
  const now = audioCtx.currentTime;
  const osc = audioCtx.createOscillator();
  const gain = audioCtx.createGain();
  osc.type = 'sine';
  osc.frequency.setValueAtTime(freq, now);
  gain.gain.setValueAtTime(0.3, now);
  gain.gain.exponentialRampToValueAtTime(0.01, now + dur);
  osc.connect(gain); gain.connect(audioCtx.destination);
  osc.start(now); osc.stop(now + dur);
}

/* ══════════════════════════════════════════════════════════
   ESTADO GLOBAL & BLUETOOTH
══════════════════════════════════════════════════════════ */
const UUID_SERVICE_EMG = '4fafc201-1fb5-459e-8fcc-c5c9c331914b';
const UUID_CHAR_EMG    = 'beb5483e-36e1-4688-b7f5-ea07361b26a8';
const UUID_SERVICE_CAR = '6e400001-b5a3-f393-e0a9-e50e24dcca9e';
const UUID_CHAR_CAR    = '6e400002-b5a3-f393-e0a9-e50e24dcca9e';

const bleState = {
  L:   { device: null, server: null, char: null, connected: false, val: 0 },
  R:   { device: null, server: null, char: null, connected: false, val: 0 },
  CAR: { device: null, server: null, char: null, connected: false }
};

let isDemoMode = false;
let activePatient = null;
let currentAppMode = null; // 'games' o 'auto'

// Helper seguro de escritura BLE
async function safeWriteBLE(charObj, textData) {
  if (!charObj) return;
  try {
    const encoded = new TextEncoder().encode(textData);
    if (charObj.writeValueWithoutResponse) {
      await charObj.writeValueWithoutResponse(encoded);
    } else {
      await charObj.writeValue(encoded);
    }
  } catch(e) {
    console.warn("Error escribiendo BLE:", e);
  }
}

// Conexión Bluetooth Individual
async function connectDevice(type) {
  if (!navigator.bluetooth) {
    alert("Web Bluetooth no está disponible. Usa Chrome en Android o Bluefy en iOS sobre HTTPS.");
    return;
  }

  const srvUUID = (type === 'CAR') ? UUID_SERVICE_CAR : UUID_SERVICE_EMG;
  const charUUID = (type === 'CAR') ? UUID_CHAR_CAR : UUID_CHAR_EMG;
  const targetName = (type === 'CAR') ? 'Robrain-Car' : (type === 'L' ? 'Robrain-EMG-L' : 'Robrain-EMG-R');
  const cardId = (type === 'CAR') ? 'cardCar' : (type === 'L' ? 'cardEMGL' : 'cardEMGR');
  const statusId = (type === 'CAR') ? 'statusCar' : (type === 'L' ? 'statusEMGL' : 'statusEMGR');
  const btnId = (type === 'CAR') ? 'btnConnectCar' : (type === 'L' ? 'btnConnectEMGL' : 'btnConnectEMGR');

  const card = document.getElementById(cardId);
  const statusEl = document.getElementById(statusId);
  const btn = document.getElementById(btnId);

  statusEl.className = 'ble-status';
  statusEl.innerText = 'Buscando...';
  card.className = 'ble-card connecting';
  btn.disabled = true;

  try {
    const device = await navigator.bluetooth.requestDevice({
      filters: [{ name: targetName }],
      optionalServices: [srvUUID]
    });

    device.addEventListener('gattserverdisconnected', () => {
      bleState[type].connected = false;
      statusEl.className = 'ble-status err';
      statusEl.innerText = 'Desconectado ❌';
      card.className = 'ble-card error';
      btn.disabled = false;
      btn.innerText = 'Reconectar';
      checkAllBleReady();
      updateSettingsUI();
    });

    statusEl.innerText = 'Conectando...';
    const server = await device.gatt.connect();
    const service = await server.getPrimaryService(srvUUID);
    const characteristic = await service.getCharacteristic(charUUID);

    if (type !== 'CAR') {
      await characteristic.startNotifications();
      characteristic.addEventListener('characteristicvaluechanged', (e) => {
        const raw = new TextDecoder().decode(e.target.value).trim();
        const num = parseInt(raw) || 0;
        bleState[type].val = num;
        onEMGDataReceived(type, num);
      });
    }

    bleState[type].device = device;
    bleState[type].server = server;
    bleState[type].char = characteristic;
    bleState[type].connected = true;

    statusEl.className = 'ble-status ok';
    statusEl.innerText = 'Conectado ✅';
    card.className = 'ble-card connected';
    btn.disabled = false;
    btn.innerText = 'Listo';

    checkAllBleReady();
    updateSettingsUI();
  } catch(err) {
    if (err.name !== 'NotFoundError') {
      statusEl.className = 'ble-status err';
      statusEl.innerText = 'Error de conexión';
      card.className = 'ble-card error';
    } else {
      statusEl.innerText = 'Cancelado';
      card.className = 'ble-card';
    }
    btn.disabled = false;
  }
}

function checkAllBleReady() {
  const ready = (bleState.L.connected && bleState.R.connected) || isDemoMode;
  document.getElementById('btnContinueBLE').disabled = !ready;
  if (ready) {
    document.getElementById('bleHelpText').style.display = 'none';
  }
}

function enableDemoMode() {
