      border-bottom: 3px solid var(--border-color);
      padding: 10px 16px;
      display: flex; align-items: center; justify-content: space-between;
      flex-shrink: 0; z-index: 10;
    }
    .header-logo { font-size: 19px; font-weight: 700; color: var(--primary-dark); }
    .header-pills { display: flex; gap: 6px; }
    .emg-pill {
      font-size: 11px; font-weight: 700;
      padding: 4px 8px; border-radius: 8px;
      background: var(--border-color); color: var(--text-muted);
      font-family: 'Space Mono', monospace; min-width: 65px;
      text-align: center; transition: all 0.15s ease;
    }
    .emg-pill.active-L { background: var(--primary-light); color: var(--primary-dark); border: 1px solid var(--primary-border); }
    .emg-pill.active-R { background: var(--secondary-light); color: var(--secondary); border: 1px solid var(--secondary); }

    /* ── BOTTOM NAV ──────────────────────────────── */
    .bottom-nav {
      background: #ffffff;
      border-top: 3px solid var(--border-color);
      display: flex; flex-shrink: 0; z-index: 10;
      position: fixed; bottom: 0; width: 100%;
      padding-bottom: env(safe-area-inset-bottom);
    }
    .nav-btn {
      flex: 1; background: none; border: none;
      padding: 10px 4px 8px; display: flex; flex-direction: column;
      align-items: center; gap: 3px; cursor: pointer;
      font-family: 'Fredoka', sans-serif; font-size: 11px;
      font-weight: 700; color: #b0b5d0; transition: color 0.15s;
    }
    .nav-btn .nav-icon { font-size: 20px; line-height: 1; }
    .nav-btn.active { color: var(--primary); }

    /* ── BOTONES ─────────────────────────────────── */
    .btn {
      background: var(--primary-border); border: none;
      color: var(--primary-dark);
      padding: 14px 20px; border-radius: 16px;
      font-weight: 700; font-size: 16px;
      cursor: pointer; text-align: center;
      box-shadow: 0 5px 0 #84b7aa;
      width: 100%; transition: all 0.15s;
      font-family: 'Fredoka', sans-serif;
    }
    .btn:active { transform: translateY(3px); box-shadow: 0 2px 0 #84b7aa; }
    .btn:disabled { opacity: 0.45; cursor: not-allowed; transform: none !important; box-shadow: none; }
    
    .btn-coral { background: var(--accent-coral-light); color: #a44a5e; box-shadow: 0 5px 0 #ffb3c1; }
    .btn-coral:active { box-shadow: 0 2px 0 #ffb3c1; }
    .btn-purple { background: var(--secondary-light); color: #432b75; box-shadow: 0 5px 0 #cbb2f0; }
    .btn-purple:active { box-shadow: 0 2px 0 #cbb2f0; }
    .btn-gold { background: var(--accent-gold-light); color: #82622b; box-shadow: 0 5px 0 #ffe082; }

    .btn-mode {
      width: 100%; padding: 16px; border-radius: 20px;
      font-size: 17px; margin-bottom: 12px;
      cursor: pointer; border: 3px solid transparent;
      font-family: 'Fredoka', sans-serif; font-weight: 700;
      text-align: left; transition: all 0.15s;
    }
    .btn-mode:active { transform: translateY(3px); }
    .btn-mode-auto  { background: var(--primary-light); color: var(--primary-dark); border-color: var(--primary-border); box-shadow: 0 5px 0 #84b7aa; }
    .btn-mode-games { background: var(--secondary-light); color: #3d3080; border-color: var(--secondary); box-shadow: 0 5px 0 #7a45c4; }

    /* ── TARJETAS BLE ────────────────────────────── */
    .ble-card {
      display: flex; align-items: center; gap: 12px;
      background: #ffffff; border: 2px solid #e8e8ef;
      border-radius: 16px; padding: 12px 14px;
      margin-bottom: 10px; text-align: left;
      transition: all 0.2s;
    }
    .ble-card.connected  { background: var(--primary-light); border-color: var(--primary-border); }
    .ble-card.connecting { background: var(--accent-gold-light); border-color: #ffd54f; }
    .ble-card.error      { background: #fff5f5; border-color: var(--accent-coral); }
    .ble-icon { font-size: 26px; flex-shrink: 0; }
    .ble-info { flex: 1; }
    .ble-name { font-size: 14px; font-weight: 700; color: var(--text); }
    .ble-status { font-size: 12px; color: var(--text-muted); font-weight: 500; }
    .ble-status.ok { color: #27ae60; font-weight: 700; }
    .ble-status.err { color: #c0392b; font-weight: 700; }
    .ble-btn {
      background: var(--primary-border); border: none;
      color: var(--primary-dark); padding: 8px 12px;
      border-radius: 12px; font-size: 12px; font-weight: 700;
      cursor: pointer; font-family: 'Fredoka', sans-serif;
      box-shadow: 0 3px 0 #84b7aa; flex-shrink: 0;
    }
    .ble-btn:active { transform: translateY(2px); box-shadow: 0 1px 0 #84b7aa; }

    /* ── PACIENTES ───────────────────────────────── */
    .patient-item {
      background: #ffffff; border: 2px solid var(--border-color);
      border-radius: 18px; padding: 12px 14px;
      cursor: pointer; display: flex; align-items: center;
      gap: 12px; margin-bottom: 10px; transition: all 0.15s;
    }
    .patient-item:active { transform: scale(0.98); border-color: var(--primary-border); }
    .patient-item.selected { border-color: var(--primary); background: var(--primary-light); }
    .patient-avatar {
      width: 42px; height: 42px; background: #e8f5f1;
      border-radius: 14px; display: flex; align-items: center;
      justify-content: center; font-size: 22px; flex-shrink: 0;
    }
    input[type="text"], input[type="number"] {
      background: #ffffff; border: 2px solid #cbd5e1;
      color: var(--text); padding: 12px 14px; border-radius: 14px;
      font-family: 'Fredoka', sans-serif; font-size: 15px;
      width: 100%; outline: none; margin-bottom: 10px;
    }
    input:focus { border-color: var(--primary-border); }

    /* ── CALIBRACIÓN ─────────────────────────────── */
    .progress-bar-outer {
      background: #e2ece9; border-radius: 99px;
      height: 16px; margin: 14px 0; overflow: hidden; width: 100%;
    }
    .progress-bar-inner {
      height: 100%; background: linear-gradient(90deg, var(--primary), #76ead7);
      width: 0%; transition: width 0.08s linear;
    }
    .calib-gauge-box {
      display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-top: 12px;
    }
    .calib-gauge {
      background: #ffffff; border: 2px solid var(--border-color);
      border-radius: 14px; padding: 10px; text-align: center;
    }

    /* ── JUEGOS Y CANVAS ─────────────────────────── */
    .game-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
    .game-card {
      border-radius: 20px; padding: 14px 12px;
      cursor: pointer; border: 3px solid transparent;
      display: flex; flex-direction: column; gap: 6px;
      transition: all 0.15s;
    }
    .game-card:active { transform: scale(0.96); }
    .game-icon { font-size: 32px; }
    .game-title { font-size: 14px; font-weight: 700; line-height: 1.2; }
    .game-desc { font-size: 11px; opacity: 0.8; line-height: 1.3; }

    .canvas-container {
      position: relative; width: 100%; height: 280px;
      background: #191c2b; border-radius: 20px;
      overflow: hidden; box-shadow: inset 0 4px 12px rgba(0,0,0,0.4);
    }
    #gameCanvas { width: 100%; height: 100%; display: block; }

    /* ── HISTORIAL Y DASHBOARD ───────────────────── */
    .history-card {
      display: flex; justify-content: space-between;
      background: #ffffff; padding: 10px 14px;
      border-radius: 14px; border: 2px solid var(--border-color);
      font-size: 13px; font-weight: 500; align-items: center;
    }
    .stats-row {
      display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-bottom: 12px;
    }
    .stat-box {
      background: #ffffff; border: 2px solid var(--border-color);
      border-radius: 16px; padding: 12px; text-align: center;
    }
  </style>
</head>
<body>

<!-- ══════════════════════════════════════════════════════
     PANTALLA 1: CONEXIÓN BLUETOOTH (3 DISPOSITIVOS)
══════════════════════════════════════════════════════ -->
<div id="scrnBLE" class="screen">
  <div class="card-modal">
    <div style="font-size:46px; margin-bottom:10px;">🧠✨</div>
    <h1 style="font-size:24px; font-weight:700; color:var(--primary-dark); margin-bottom:4px;">Robrain Kids</h1>
    <p style="color:var(--text-muted); font-size:13px; margin-bottom:18px;">Conectá los dispositivos para comenzar</p>

    <!-- Brazo Izquierdo -->
    <div class="ble-card" id="cardEMGL">
      <div class="ble-icon">👈</div>
      <div class="ble-info">
        <div class="ble-name">Brazo Izquierdo <span style="color:#e63946; font-size:10px;">*requerido</span></div>
        <div class="ble-status" id="statusEMGL">Desconectado</div>
      </div>
      <button class="ble-btn" id="btnConnectEMGL" onclick="connectDevice('L')">Conectar</button>
    </div>

    <!-- Brazo Derecho -->
    <div class="ble-card" id="cardEMGR">
      <div class="ble-icon">👉</div>
      <div class="ble-info">
        <div class="ble-name">Brazo Derecho <span style="color:#e63946; font-size:10px;">*requerido</span></div>
        <div class="ble-status" id="statusEMGR">Desconectado</div>
      </div>
      <button class="ble-btn" id="btnConnectEMGR" onclick="connectDevice('R')">Conectar</button>
    </div>

    <!-- Auto RC -->
    <div class="ble-card" id="cardCar">
      <div class="ble-icon">🚗</div>
      <div class="ble-info">
        <div class="ble-name">Auto RC <span style="font-size:11px; color:var(--text-muted);">(Modo Auto)</span></div>
        <div class="ble-status" id="statusCar">Desconectado</div>
      </div>
      <button class="ble-btn" id="btnConnectCar" onclick="connectDevice('CAR')" style="background:var(--secondary-light); color:#432b75;">Conectar</button>
    </div>

    <button class="btn" id="btnContinueBLE" onclick="navTo('scrnPatients')" disabled style="margin-top:16px;">
      Continuar →
    </button>
    <p id="bleHelpText" style="font-size:11px; color:var(--text-muted); margin-top:8px;">
      Conectá ambos brazos para habilitar el sistema
    </p>

    <!-- Botón para pruebas de simulación en PC sin hardware -->
    <button onclick="enableDemoMode()" style="background:none; border:none; color:#b0b5d0; font-size:11px; text-decoration:underline; cursor:pointer; margin-top:14px;">
      ⚡ Probar en modo simulador (sin hardware)
    </button>
  </div>
</div>

<!-- ══════════════════════════════════════════════════════
     PANTALLA 2: GESTIÓN DE PACIENTES
══════════════════════════════════════════════════════ -->
<div id="scrnPatients" class="screen hidden">
  <div class="card-modal" style="padding:22px 18px;">
    <h2 style="font-size:22px; font-weight:700; color:var(--primary-dark); margin-bottom:4px;">¿Quién entrena hoy?</h2>
    <p style="color:var(--text-muted); font-size:13px; margin-bottom:16px;">Seleccioná o agregá un paciente</p>

    <div id="patientList" style="max-height:220px; overflow-y:auto; margin-bottom:12px;"></div>

    <div style="background:#fdfbf7; border:2px dashed var(--primary-border); border-radius:18px; padding:12px; margin-top:10px;">
      <div style="font-size:13px; font-weight:700; color:var(--primary-dark); margin-bottom:6px;">➕ Nuevo Amiguito</div>
      <input type="text" id="inpNewName" placeholder="Nombre completo (ej: Mateo)">
      <input type="text" id="inpNewDiag" placeholder="Diagnóstico / Objetivo (opcional)">
      <button class="btn btn-coral" style="padding:10px; font-size:14px;" onclick="addPatient()">Guardar Paciente</button>
    </div>

    <button onclick="navTo('scrnBLE')" style="background:none; border:none; color:var(--text-muted); font-size:12px; cursor:pointer; margin-top:14px;">
      ← Volver a Bluetooth
    </button>
  </div>
</div>

<!-- ══════════════════════════════════════════════════════
     PANTALLA 3: SELECCIÓN DE MODO
══════════════════════════════════════════════════════ -->
<div id="scrnMode" class="screen hidden">
  <div class="card-modal">
    <div style="font-size:42px; margin-bottom:10px;">🎯</div>
    <h2 id="lblModeGreeting" style="font-size:24px; font-weight:700; color:var(--primary-dark); margin-bottom:4px;"></h2>
    <p style="color:var(--text-muted); font-size:13px; margin-bottom:20px;">¿Qué querés hacer hoy?</p>

    <button class="btn-mode btn-mode-games" onclick="startFlow('games')">
      🎮 Mini Juegos de Rehabilitación
      <div style="font-size:12px; font-weight:500; opacity:0.8; margin-top:4px;">4 juegos adaptados para ejercitar músculos</div>
    </button>

    <button class="btn-mode btn-mode-auto" onclick="startFlow('auto')">
      🚗 Manejar el Auto (Control Directo)
      <div style="font-size:12px; font-weight:500; opacity:0.8; margin-top:4px;">ESP-NOW de ultra baja latencia (<2ms)</div>
    </button>

    <button onclick="navTo('scrnPatients')" style="background:none; border:none; color:var(--text-muted); font-size:13px; cursor:pointer; margin-top:10px;">
      ← Cambiar Paciente
    </button>
  </div>
</div>

<!-- ══════════════════════════════════════════════════════
     PANTALLA 4: CALIBRACIÓN GUIADA (2 FASES)
══════════════════════════════════════════════════════ -->
<div id="scrnCalib" class="screen hidden">
  <div class="card-modal">
    <div id="calibEmoji" style="font-size:48px; margin-bottom:8px;">🧘</div>
    <h2 id="calibTitle" style="font-size:22px; font-weight:700; color:var(--primary-dark);">Fase 1: Reposo</h2>
    <p id="calibDesc" style="color:var(--text-muted); font-size:13px; margin:8px 0 14px;">
      Mantené los brazos completamente relajados...
    </p>

    <div class="progress-bar-outer">
      <div class="progress-bar-inner" id="calibProgress"></div>
    </div>

    <div class="calib-gauge-box mono">
      <div class="calib-gauge" style="background:#e8f5f1;">
        <div style="font-size:11px; color:var(--primary-dark); font-weight:700;">BRAZO IZQ</div>
        <div style="font-size:20px; font-weight:700; color:var(--primary);" id="calibLiveL">0</div>
        <div style="font-size:10px; color:#888;">Umbral: <span id="calibThreshL">--</span></div>
      </div>
      <div class="calib-gauge" style="background:#f3f0fc;">
        <div style="font-size:11px; color:#3d3080; font-weight:700;">BRAZO DER</div>
        <div style="font-size:20px; font-weight:700; color:var(--secondary);" id="calibLiveR">0</div>
        <div style="font-size:10px; color:#888;">Umbral: <span id="calibThreshR">--</span></div>
      </div>
    </div>

    <div id="calibActionContainer" style="margin-top:16px;">
      <button class="btn btn-gold hidden" id="btnStartPhase2" onclick="startCalibPhase2()">
        💪 ¡Listo para hacer Fuerza Máxima!
      </button>
      <button class="btn hidden" id="btnFinishCalib" onclick="finishCalibration()">
        ✅ Guardar y Comenzar
      </button>
    </div>
  </div>
</div>

<!-- ══════════════════════════════════════════════════════
     PANTALLA 5: APLICACIÓN PRINCIPAL (JUEGOS / AUTO)
══════════════════════════════════════════════════════ -->
<div id="scrnApp" class="app-layout hidden">
  <!-- Header -->
  <div class="app-header">
    <div>
      <div class="header-logo">🤖 Robrain Kids</div>
      <div style="font-size:11px; color:var(--text-muted);" id="lblCurrentPatientHeader">Paciente: --</div>
    </div>
    <div class="header-pills">
      <div class="emg-pill" id="hudPillL">Izq: 0</div>
      <div class="emg-pill" id="hudPillR">Der: 0</div>
    </div>
  </div>

  <!-- Vista 1: Sección Juegos -->
  <div class="main-content" id="viewGames">
    
    <!-- Canvas de Juego Activo -->
    <div id="boxGameActive" class="hidden" style="display:flex; flex-direction:column; gap:12px;">
      <div style="display:flex; justify-content:space-between; align-items:center;">
        <div>
          <div style="font-size:16px; font-weight:700; color:var(--primary);" id="lblActiveGameTitle">Juego</div>
          <div style="font-size:11px; color:var(--text-muted);">Usa: <b id="lblGameHelp">Izq (←) | Ambos (↑) | Der (→)</b></div>
        </div>
        <div style="display:flex; gap:6px;">
          <button class="btn" style="width:auto; padding:6px 12px; font-size:12px; background:#fff; color:#666;" onclick="togglePauseGame()" id="btnPauseGame">⏸️</button>
          <button class="btn btn-coral" style="width:auto; padding:6px 14px; font-size:12px;" onclick="stopGame(true)">✕ Salir</button>
        </div>
      </div>
      <div class="canvas-container">
        <canvas id="gameCanvas"></canvas>
      </div>
    </div>

    <!-- Menú Principal de Juegos -->
    <div id="boxGameMenu">
      <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:12px;">
        <h2 style="font-size:20px; font-weight:700; color:var(--primary-dark);">¡Elegí tu aventura!</h2>
        <!-- Selector de Dificultad -->
        <select id="selDifficulty" style="padding:6px 10px; border-radius:12px; font-family:'Fredoka'; font-size:12px; font-weight:700; border:2px solid var(--border-color); outline:none;">
          <option value="1">Tortuga 🐢 (Fácil)</option>
          <option value="1.4" selected>Gato 🐱 (Medio)</option>
          <option value="2">Guepardo 🐆 (Rápido)</option>
        </select>
      </div>

      <div class="game-grid">
        <!-- Juego 1 -->
        <div class="game-card" onclick="launchGame('balloons')" style="background:#f4f9f4; border-color:var(--primary-border);">
          <div class="game-icon">🎈</div>
          <div class="game-title" style="color:#2e4740;">Estallido de Globos</div>
          <div class="game-desc">Explotá globos usando el brazo correspondiente a tiempo.</div>
        </div>
        <!-- Juego 2 -->
        <div class="game-card" onclick="launchGame('reaction')" style="background:#fffaf0; border-color:var(--accent-gold);">
          <div class="game-icon">🐹🔨</div>
          <div class="game-title" style="color:#82622b;">Pegale al Topo</div>
          <div class="game-desc">Reaccioná rápido cuando salga el topo (Izq, Ambos o Der).</div>
        </div>
        <!-- Juego 3 -->
        <div class="game-card" onclick="launchGame('car')" style="background:#fdf2f4; border-color:var(--accent-coral-light);">
          <div class="game-icon">🏎️💨</div>
          <div class="game-title" style="color:#a44a5e;">Súper Auto Adaptado</div>
          <div class="game-desc">Esquivá obstáculos y juntá monedas en la pista.</div>
        </div>
        <!-- Juego 4 -->
        <div class="game-card" onclick="launchGame('guitar')" style="background:var(--secondary-light); border-color:var(--secondary);">
          <div class="game-icon">🎸⭐</div>
          <div class="game-title" style="color:#52489c;">Estrella de Rock</div>
          <div class="game-desc">Seguí el ritmo de las notas musicales al caer.</div>
        </div>
      </div>

      <h3 style="font-size:16px; font-weight:700; margin:22px 0 10px; color:var(--text);">🏆 Progreso de Sesiones</h3>
      <div id="patientHistoryContainer" style="display:flex; flex-direction:column; gap:8px;"></div>
    </div>
  </div>

  <!-- Vista 2: Sección Auto RC -->
  <div class="main-content hidden" id="viewAuto" style="text-align:center;">
    <div style="font-size:56px; margin:16px 0 8px;">🏎️💨</div>
    <h2 style="font-size:22px; font-weight:700; color:var(--primary-dark); margin-bottom:4px;">Control del Auto RC</h2>
    <p style="font-size:13px; color:var(--text-muted); margin-bottom:16px;">
      Comunicación directa ESP-NOW activa (<2ms)
    </p>

    <!-- Display de Estado -->
    <div style="background:#ffffff; border:3px solid var(--border-color); border-radius:24px; padding:20px; margin-bottom:16px;">
      <div style="font-size:11px; font-weight:700; color:#a2a7cb; letter-spacing:0.5px;">ESTADO DE MOVIMIENTO</div>
      <div id="autoCmdDisplay" style="font-size:36px; font-weight:700; color:var(--primary); margin:8px 0;">■ FRENADO</div>
      
      <div style="display:grid; grid-template-columns:1fr 1fr; gap:10px; margin-top:14px;" class="mono">
        <div style="background:#f7f7fc; padding:10px; border-radius:12px;" id="autoArmL">
          <div style="font-size:11px; color:#666;">Brazo Izq</div>
          <div style="font-size:16px; font-weight:700;" id="autoValL">0</div>
        </div>
        <div style="background:#f7f7fc; padding:10px; border-radius:12px;" id="autoArmR">
          <div style="font-size:11px; color:#666;">Brazo Der</div>
          <div style="font-size:16px; font-weight:700;" id="autoValR">0</div>
        </div>
      </div>
    </div>

    <!-- Guía de Control -->
    <div style="background:#ffffff; border:2px solid var(--border-color); border-radius:18px; padding:14px; text-align:left; font-size:13px; line-height:2.1; margin-bottom:16px;">
      <b>Brazo Izquierdo</b> → Girar Izquierda ◄<br>
      <b>Brazo Derecho</b> → Girar Derecha ►<br>
      <b>Ambos brazos juntos</b> → Avanzar ▲<br>
      <b>Sin fuerza (reposo)</b> → Freno automático ■
    </div>

    <!-- Botón Parada de Emergencia -->
    <button class="btn btn-coral" style="padding:14px;" onclick="emergencyStop()">
      🛑 PARADA DE EMERGENCIA
    </button>
  </div>

  <!-- Vista 3: Ajustes / Paciente -->
  <div class="main-content hidden" id="viewSettings">
    <h2 style="font-size:20px; font-weight:700; margin-bottom:14px;">⚙️ Configuración y Calibración</h2>
    <div style="background:#ffffff; border:2px solid var(--border-color); border-radius:18px; padding:16px; margin-bottom:14px;">
      <div style="font-size:14px; font-weight:700; margin-bottom:8px;">Perfil Actual</div>
      <div id="settingsPatientInfo" style="font-size:13px; color:var(--text-muted); line-height:1.8;"></div>
      <button class="btn" style="margin-top:12px; font-size:14px; padding:10px;" onclick="recalibrateCurrentPatient()">
        🔄 Recalibrar Sensores
      </button>
    </div>

