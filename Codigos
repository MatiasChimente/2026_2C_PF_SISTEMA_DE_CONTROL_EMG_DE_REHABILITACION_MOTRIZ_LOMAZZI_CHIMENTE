/* ══════════════════════════════════════════════════════════
   CALIBRACIÓN EN 2 FASES (REPOSO + TENSIÓN MÁXIMA)
══════════════════════════════════════════════════════════ */
let calibTimer = null;
let calibSamples = { restL: [], restR: [], maxL: [], maxR: [] };
let isCalibrating = false;

function startFlow(mode) {
  currentAppMode = mode;
  // Si el paciente nunca calibró o queremos recalibrar:
  startCalibPhase1();
}

function startCalibPhase1() {
  navTo('scrnCalib');
  isCalibrating = true;
  calibSamples = { restL: [], restR: [], maxL: [], maxR: [] };

  document.getElementById('calibEmoji').innerText = '🧘';
  document.getElementById('calibTitle').innerText = 'Fase 1: Reposo';
  document.getElementById('calibDesc').innerText = 'Mantené los brazos completamente relajados...';
  document.getElementById('calibProgress').style.width = '0%';
  document.getElementById('btnStartPhase2').classList.add('hidden');
  document.getElementById('btnFinishCalib').classList.add('hidden');

  let pct = 0;
  clearInterval(calibTimer);
  calibTimer = setInterval(() => {
    pct += 2.5; // ~4 segundos
    document.getElementById('calibProgress').style.width = pct + '%';
    calibSamples.restL.push(bleState.L.val);
    calibSamples.restR.push(bleState.R.val);

    if (pct >= 100) {
      clearInterval(calibTimer);
      playSound('pop');
      document.getElementById('calibEmoji').innerText = '✨';
      document.getElementById('calibTitle').innerText = '¡Reposo registrado!';
      document.getElementById('calibDesc').innerText = 'Ahora mediremos la fuerza máxima voluntaria.';
      document.getElementById('btnStartPhase2').classList.remove('hidden');
    }
  }, 100);
}

function startCalibPhase2() {
  document.getElementById('calibEmoji').innerText = '💪';
  document.getElementById('calibTitle').innerText = 'Fase 2: ¡Tensión Máxima!';
  document.getElementById('calibDesc').innerText = '¡Apretá los dos brazos con fuerza!';
  document.getElementById('calibProgress').style.width = '0%';
  document.getElementById('btnStartPhase2').classList.add('hidden');

  let pct = 0;
  clearInterval(calibTimer);
  calibTimer = setInterval(() => {
    pct += 2.5;
    document.getElementById('calibProgress').style.width = pct + '%';
    calibSamples.maxL.push(bleState.L.val);
    calibSamples.maxR.push(bleState.R.val);

    if (pct >= 100) {
      clearInterval(calibTimer);
      isCalibrating = false;
      playSound('win');

      // 1. Cálculo de Medias y Picos
      const avgRestL = Math.round(calibSamples.restL.reduce((a,b)=>a+b,0) / (calibSamples.restL.length || 1));
      const avgRestR = Math.round(calibSamples.restR.reduce((a,b)=>a+b,0) / (calibSamples.restR.length || 1));
      const peakMaxL = Math.max(...calibSamples.maxL, avgRestL + 500);
      const peakMaxR = Math.max(...calibSamples.maxR, avgRestR + 500);

      // 2. Umbral inteligente: 35% del rango dinámico
      const threshL = Math.round(avgRestL + (peakMaxL - avgRestL) * 0.35);
      const threshR = Math.round(avgRestR + (peakMaxR - avgRestR) * 0.35);

      // 3. Guardar en paciente
      activePatient.restL = avgRestL; activePatient.restR = avgRestR;
      activePatient.maxL = peakMaxL;   activePatient.maxR = peakMaxR;
      activePatient.threshL = threshL; activePatient.threshR = threshR;
      savePatients();

      // 4. Mostrar en pantalla
      document.getElementById('calibThreshL').innerText = threshL;
      document.getElementById('calibThreshR').innerText = threshR;
      document.getElementById('calibEmoji').innerText = '🎉';
      document.getElementById('calibTitle').innerText = '¡Calibración Exitosa!';
      document.getElementById('calibDesc').innerText = `Umbral Izq: ${threshL} | Umbral Der: ${threshR}`;
      document.getElementById('btnFinishCalib').classList.remove('hidden');

      // 5. Enviar nuevos umbrales a los ESP32-C3 por BLE
      safeWriteBLE(bleState.L.char, `SET_TH:${threshL}`);
      safeWriteBLE(bleState.R.char, `SET_TH:${threshR}`);
    }
  }, 100);
}

function finishCalibration() {
  navTo('scrnApp');
  if (currentAppMode === 'auto') {
    switchAppTab('auto');
    // Activar modo Auto en los ESP32 (inicia transmisión directa ESP-NOW)
    safeWriteBLE(bleState.L.char, 'MODE:AUTO');
    safeWriteBLE(bleState.R.char, 'MODE:AUTO');
  } else {
    switchAppTab('games');
    safeWriteBLE(bleState.L.char, 'MODE:GAMES');
    safeWriteBLE(bleState.R.char, 'MODE:GAMES');
  }
}

function recalibrateCurrentPatient() {
  startCalibPhase1();
}

/* ══════════════════════════════════════════════════════════
   PROCESAMIENTO DE SEÑALES EMG EN TIEMPO REAL
══════════════════════════════════════════════════════════ */
let lastActiveCommand = "STOP";

function onEMGDataReceived(arm, val) {
  // Actualizar gauges del header
  const pillL = document.getElementById('hudPillL');
  const pillR = document.getElementById('hudPillR');
  
  const threshL = (activePatient ? activePatient.threshL : 1500);
  const threshR = (activePatient ? activePatient.threshR : 1500);

  const actL = bleState.L.val >= threshL;
  const actR = bleState.R.val >= threshR;

  if (pillL) {
    pillL.innerText = `Izq: ${bleState.L.val}`;
    pillL.className = 'emg-pill' + (actL ? ' active-L' : '');
  }
  if (pillR) {
    pillR.innerText = `Der: ${bleState.R.val}`;
    pillR.className = 'emg-pill' + (actR ? ' active-R' : '');
  }

  // Actualizar gauges de calibración si está activa
  if (isCalibrating) {
    document.getElementById('calibLiveL').innerText = bleState.L.val;
    document.getElementById('calibLiveR').innerText = bleState.R.val;
  }

  // Actualizar señal en vivo en el panel de Ajustes (referencia para el profesional)
  const liveL = document.getElementById('liveValL_settings');
  const liveR = document.getElementById('liveValR_settings');
  if (liveL) liveL.innerText = bleState.L.val;
  if (liveR) liveR.innerText = bleState.R.val;

  // Actualizar modo Auto
  if (currentAppMode === 'auto') {
    document.getElementById('autoValL').innerText = bleState.L.val;
    document.getElementById('autoValR').innerText = bleState.R.val;
    document.getElementById('autoArmL').style.background = actL ? 'var(--primary-light)' : '#f7f7fc';
    document.getElementById('autoArmR').style.background = actR ? 'var(--secondary-light)' : '#f7f7fc';

    let cmd = "STOP";
    if (actL && actR) cmd = "FORWARD";
    else if (actL) cmd = "LEFT";
    else if (actR) cmd = "RIGHT";

    if (cmd !== lastActiveCommand) {
      lastActiveCommand = cmd;
      const cmdMap = { FORWARD: '▲ AVANZAR', LEFT: '◄ IZQUIERDA', RIGHT: '► DERECHA', STOP: '■ FRENADO' };
      document.getElementById('autoCmdDisplay').innerText = cmdMap[cmd];

      // Enviar respaldo por BLE al auto si está conectado
      if (bleState.CAR.connected) {
        safeWriteBLE(bleState.CAR.char, cmd);
      }
    }
  }
}

function emergencyStop() {
  lastActiveCommand = "STOP";
  document.getElementById('autoCmdDisplay').innerText = '■ FRENADO';
  if (bleState.CAR.connected) {
    safeWriteBLE(bleState.CAR.char, "STOP");
  }
}

/* ══════════════════════════════════════════════════════════
   SENSIBILIDAD CONFIGURABLE POR PACIENTE
══════════════════════════════════════════════════════════ */
function updateSettingsSensitivity() {
  if (!activePatient) return;
  const tL = activePatient.threshL || 800;
  const tR = activePatient.threshR || 800;
  const slL = document.getElementById('sliderThreshL');
  const slR = document.getElementById('sliderThreshR');
  if (slL) { slL.value = tL; document.getElementById('lblThreshL').innerText = tL; }
  if (slR) { slR.value = tR; document.getElementById('lblThreshR').innerText = tR; }
}

function onSliderThresh(arm, val) {
  val = parseInt(val);
  if (arm === 'L') document.getElementById('lblThreshL').innerText = val;
  else             document.getElementById('lblThreshR').innerText = val;
}

function applyPreset(level) {
  if (!activePatient) return;
  // Los presets se calculan como fracción del rango dinámico calibrado
  const restL  = activePatient.restL  || 200;
  const restR  = activePatient.restR  || 200;
  const maxL   = activePatient.maxL   || 2000;
  const maxR   = activePatient.maxR   || 2000;
  const pct = level === 'alta' ? 0.50 : level === 'media' ? 0.30 : 0.15;
  const tL = Math.round(restL + (maxL - restL) * pct);
  const tR = Math.round(restR + (maxR - restR) * pct);
  document.getElementById('sliderThreshL').value = tL;
  document.getElementById('sliderThreshR').value = tR;
  document.getElementById('lblThreshL').innerText = tL;
  document.getElementById('lblThreshR').innerText = tR;
}

function saveThresholds() {
  if (!activePatient) return;
  const tL = parseInt(document.getElementById('sliderThreshL').value);
  const tR = parseInt(document.getElementById('sliderThreshR').value);
  activePatient.threshL = tL;
  activePatient.threshR = tR;
  savePatients();
  // Enviar nuevos umbrales a los ESP32-C3
  safeWriteBLE(bleState.L.char, `SET_TH:${tL}`);
  safeWriteBLE(bleState.R.char, `SET_TH:${tR}`);
  const msg = document.getElementById('threshSaveMsg');
  msg.innerText = `✅ Guardado — Izq: ${tL} · Der: ${tR}`;
  setTimeout(() => { msg.innerText = ''; }, 3000);
  updateSettingsUI();
}

/* ══════════════════════════════════════════════════════════
   4 MINI-JUEGOS DE REHABILITACIÓN (Canvas 2D)
══════════════════════════════════════════════════════════ */
let canvas, ctx, animFrameId, gameInterval;
let activeGame = null;
let isPaused = false;
let gameState = {};

function launchGame(type) {
  activeGame = type;
  isPaused = false;
  document.getElementById('btnPauseGame').innerText = '⏸️';
  document.getElementById('boxGameMenu').classList.add('hidden');
  document.getElementById('boxGameActive').classList.remove('hidden');

  const titles = {
    balloons: '🎈 Estallido de Globos',
    reaction: '🐹🔨 Pegale al Topo',
    car: '🏎️💨 Súper Auto Adaptado',
    guitar: '🎸⭐ Estrella de Rock'
  };
  const helps = {
    balloons: 'Brazo Izq (←) o Brazo Der (→)',
    reaction: 'Izq (←) | ¡Ambos! (↑) | Der (→)',
    car: 'Izq (Carril 1) | Ambos (Carril 2) | Der (Carril 3)',
    guitar: 'Pista Izq (←) | Pista Centro (↑) | Pista Der (→)'
  };
  document.getElementById('lblActiveGameTitle').innerText = titles[type];
  document.getElementById('lblGameHelp').innerText = helps[type];

  canvas = document.getElementById('gameCanvas');
  ctx = canvas.getContext('2d');

  const diffMultiplier = parseFloat(document.getElementById('selDifficulty').value) || 1.4;

  // Estado inicial del motor de juego
  gameState = {
    type: type,
    score: 0,
    lives: (type === 'car' || type === 'guitar') ? 3 : 1,
    timeElapsed: 0,
    maxTime: 45,
    speed: diffMultiplier,
    items: [],
    particles: [],
    lastSpawn: 0,
    lastEmg: { L: false, R: false, both: false },
    streak: 0,
    reactionTimes: [],
    moleState: 'WAIT',
    moleHole: 1,
    moleSpawnTime: 0,
    nextMoleTime: Date.now() + 1000,
    carLane: 1,
    targetLane: 1,
    feedbackText: '',
    feedbackTimer: 0
  };

  clearInterval(gameInterval);
  gameInterval = setInterval(() => {
    if (!isPaused) gameState.timeElapsed++;
  }, 1000);

  runGameLoop();
}

function runGameLoop() {
  if (!activeGame) return;

  const w = canvas.width = canvas.parentNode.offsetWidth;
  const h = canvas.height = canvas.parentNode.offsetHeight;

  if (!isPaused) {
    // 1. Limpieza y Fondo Estelar
    ctx.clearRect(0, 0, w, h);
    ctx.fillStyle = '#191c2b';
    ctx.fillRect(0, 0, w, h);

    // Estrellas de fondo decorativas
    ctx.fillStyle = 'rgba(255,255,255,0.2)';
    ctx.fillRect(w * 0.15, h * 0.25, 2, 2);
    ctx.fillRect(w * 0.85, h * 0.35, 3, 3);
    ctx.fillRect(w * 0.45, h * 0.75, 2, 2);

    // 2. Detección de Flanco de Activación Muscular
    const threshL = activePatient ? activePatient.threshL : 1500;
    const threshR = activePatient ? activePatient.threshR : 1500;
    const isL = bleState.L.val >= threshL;
    const isR = bleState.R.val >= threshR;
    const isBoth = isL && isR;

    const pulseBoth = isBoth && !gameState.lastEmg.both;
    const pulseL = isL && !isR && !gameState.lastEmg.L;
    const pulseR = isR && !isL && !gameState.lastEmg.R;
    gameState.lastEmg = { L: isL, R: isR, both: isBoth };

    // 3. Lógica específica del juego
    // ══════════════════════════════════════════════
    // JUEGO 1: GLOBOS
    // ══════════════════════════════════════════════
    if (gameState.type === 'balloons') {
      const spawnInterval = 1400 / gameState.speed;
      if (Date.now() - gameState.lastSpawn > spawnInterval) {
        gameState.items.push({
          x: w * (0.18 + Math.random() * 0.64),
          y: h + 25,
          side: Math.random() > 0.5 ? 'L' : 'R',
          speed: (1.2 + Math.random() * 0.8) * gameState.speed,
          color: Math.random() > 0.5 ? '#ff8fa3' : '#76ead7'
        });
        gameState.lastSpawn = Date.now();
      }

      // Procesar pulsos
      if (pulseL || pulseR) {
        const targetSide = pulseL ? 'L' : 'R';
        let hitIdx = -1, lowestY = h;
        gameState.items.forEach((b, idx) => {
          if (b.side === targetSide && b.y < lowestY) {
            lowestY = b.y; hitIdx = idx;
          }
        });
        if (hitIdx !== -1) {
          const hitB = gameState.items[hitIdx];
          gameState.score += 25;
          gameState.streak++;
          playSound('pop');
          spawnParticles(hitB.x, hitB.y, hitB.color);
          gameState.items.splice(hitIdx, 1);
        }
      }

      // Renderizar y mover globos
      gameState.items = gameState.items.filter(b => {
        b.y -= b.speed;
        // Dibujo del globo
        ctx.beginPath();
        ctx.arc(b.x, b.y, 24, 0, Math.PI * 2);
        ctx.fillStyle = b.color; ctx.fill();
        ctx.strokeStyle = '#ffffff'; ctx.lineWidth = 2; ctx.stroke();

        ctx.fillStyle = '#2e4740'; ctx.font = 'bold 16px Fredoka, sans-serif';
        ctx.textAlign = 'center'; ctx.fillText(b.side, b.x, b.y + 6);

        if (b.y < 10) {
          gameState.streak = 0;
          return false;
        }
        return true;
      });

      renderHUD(w, h, `Score: 🏆 ${gameState.score}`, `Tiempo: ⏱️ ${Math.max(0, gameState.maxTime - gameState.timeElapsed)}s`);
      if (gameState.timeElapsed >= gameState.maxTime) return finishGame('Estallido de Globos');
    }

    // ══════════════════════════════════════════════
    // JUEGO 2: PEAGALE AL TOPO
    // ══════════════════════════════════════════════
    else if (gameState.type === 'reaction') {
      const holes = [w * 0.22, w * 0.5, w * 0.78];
      // Dibujar madrigueras
      holes.forEach(hx => {
        ctx.beginPath(); ctx.ellipse(hx, h / 2 + 30, 45, 18, 0, 0, Math.PI * 2);
        ctx.fillStyle = '#2c314a'; ctx.fill();
      });

      if (gameState.moleState === 'WAIT') {
        ctx.fillStyle = '#ccd0e1'; ctx.font = '16px Fredoka, sans-serif'; ctx.textAlign = 'center';
        ctx.fillText('⏳ ¡Esperá al topo...!', w / 2, h / 2 - 35);
        if (Date.now() >= gameState.nextMoleTime) {
          gameState.moleState = 'UP';
          gameState.moleHole = Math.floor(Math.random() * 3);
          gameState.moleSpawnTime = Date.now();
        }
      } else {
        // Topo visible
        ctx.font = '48px sans-serif'; ctx.textAlign = 'center';
        ctx.fillText('🐹', holes[gameState.moleHole], h / 2 + 25);

        const moleTimeout = 2800 / gameState.speed;
        if (Date.now() - gameState.moleSpawnTime > moleTimeout) {
          gameState.moleState = 'WAIT';
          gameState.nextMoleTime = Date.now() + 1200;
        }

        let pressedHole = -1;
        if (pulseL) pressedHole = 0;
        else if (pulseBoth) pressedHole = 1;
        else if (pulseR) pressedHole = 2;

        if (pressedHole !== -1) {
          if (pressedHole === gameState.moleHole) {
            const rt = Date.now() - gameState.moleSpawnTime;
            gameState.reactionTimes.push(rt);
            const pts = Math.max(20, Math.round(200 - (rt / 8)));
            gameState.score += pts;
            playSound('hit');
            spawnParticles(holes[gameState.moleHole], h / 2, '#ffdfa7');
            gameState.moleState = 'WAIT';
            gameState.nextMoleTime = Date.now() + 1000;
          }
        }
      }

      renderHUD(w, h, `Score: 🏆 ${gameState.score}`, `Tiempo: ⏱️ ${Math.max(0, gameState.maxTime - gameState.timeElapsed)}s`);
      if (gameState.timeElapsed >= gameState.maxTime) return finishGame('Pegale al Topo');
    }

    // ══════════════════════════════════════════════
    // JUEGO 3: SÚPER AUTO VIRTUAL
    // ══════════════════════════════════════════════
    else if (gameState.type === 'car') {
      if (pulseBoth) gameState.targetLane = 1;
      else if (pulseL) gameState.targetLane = 0;
      else if (pulseR) gameState.targetLane = 2;

      gameState.carLane += (gameState.targetLane - gameState.carLane) * 0.22;
      const lanes = [w * 0.22, w * 0.5, w * 0.78];

      // Dibujar carretera
      ctx.strokeStyle = 'rgba(255,255,255,0.15)'; ctx.lineWidth = 3; ctx.setLineDash([15, 15]);
      ctx.beginPath(); ctx.moveTo(w * 0.36, 0); ctx.lineTo(w * 0.36, h); ctx.moveTo(w * 0.64, 0); ctx.lineTo(w * 0.64, h); ctx.stroke();
      ctx.setLineDash([]);

      // Spawning de obstáculos y monedas
      if (Date.now() - gameState.lastSpawn > (1400 / gameState.speed)) {
        gameState.items.push({
          lane: Math.floor(Math.random() * 3),
          y: -25,
          type: Math.random() > 0.4 ? 'coin' : 'obs',
          speed: (2.5 + Math.random() * 0.8) * gameState.speed
        });
        gameState.lastSpawn = Date.now();
      }

      const playerX = lanes[0] + (lanes[2] - lanes[0]) * (gameState.carLane / 2);
      
      gameState.items = gameState.items.filter(item => {
        item.y += item.speed;
        ctx.font = '28px sans-serif'; ctx.textAlign = 'center';
        ctx.fillText(item.type === 'coin' ? '⭐' : '👾', lanes[item.lane], item.y);

        // Colisión con el auto
        if (Math.abs(playerX - lanes[item.lane]) < 35 && Math.abs(h - 55 - item.y) < 26) {
          if (item.type === 'coin') {
            gameState.score += 30; playSound('coin');
            spawnParticles(lanes[item.lane], item.y, '#ffd54f');
          } else {
            gameState.lives--; playSound('hit');
            spawnParticles(lanes[item.lane], item.y, '#ff8fa3');
          }
          return false;
        }
        return item.y < h + 25;
      });

      // Dibujar auto del jugador
      ctx.font = '40px sans-serif'; ctx.textAlign = 'center';
      ctx.fillText('🏎️', playerX, h - 45);

      renderHUD(w, h, `Score: 🏆 ${gameState.score}`, `Vidas: ${'❤️'.repeat(Math.max(0, gameState.lives))}`);
      if (gameState.lives <= 0 || gameState.timeElapsed >= gameState.maxTime) return finishGame('Súper Auto Adaptado');
    }

    // ══════════════════════════════════════════════
    // JUEGO 4: ESTRELLA DE ROCK
    // ══════════════════════════════════════════════
    else if (gameState.type === 'guitar') {
      const frets = [w * 0.25, w * 0.5, w * 0.75];
      const targetY = h - 50;

      // Pistas de guitarra
      frets.forEach((fx, i) => {
        ctx.strokeStyle = 'rgba(255,255,255,0.15)'; ctx.lineWidth = 3;
        ctx.beginPath(); ctx.moveTo(fx, 0); ctx.lineTo(fx, h); ctx.stroke();
        ctx.beginPath(); ctx.arc(fx, targetY, 20, 0, Math.PI * 2);
        ctx.strokeStyle = i === 0 ? '#ff8fa3' : i === 1 ? '#ffd54f' : '#76ead7';
        ctx.lineWidth = 3; ctx.stroke();
      });

      if (Date.now() - gameState.lastSpawn > (1100 / gameState.speed)) {
        gameState.items.push({
          lane: Math.floor(Math.random() * 3),
          y: -20,
          speed: (3.2 + Math.random() * 0.5) * gameState.speed
        });
        gameState.lastSpawn = Date.now();
      }

      let activeFret = -1;
      if (pulseL) { activeFret = 0; playSound('noteL'); }
      else if (pulseBoth) { activeFret = 1; playSound('noteBoth'); }
      else if (pulseR) { activeFret = 2; playSound('noteR'); }

      gameState.items = gameState.items.filter(n => {
        n.y += n.speed;
        const color = n.lane === 0 ? '#ff8fa3' : n.lane === 1 ? '#ffd54f' : '#76ead7';
        ctx.beginPath(); ctx.arc(frets[n.lane], n.y, 16, 0, Math.PI * 2);
        ctx.fillStyle = color; ctx.fill();

        if (activeFret === n.lane) {
          const dist = Math.abs(n.y - targetY);
          if (dist < 22) {
            gameState.score += 50; gameState.streak++;
            spawnParticles(frets[n.lane], targetY, color);
            return false;
          }
        }
        if (n.y > h - 10) {
          gameState.streak = 0;
          gameState.lives--;
          return false;
        }
        return true;
      });

      renderHUD(w, h, `Score: 🏆 ${gameState.score} (x${gameState.streak})`, `Vidas: ${'❤️'.repeat(Math.max(0, gameState.lives))}`);
      if (gameState.lives <= 0 || gameState.timeElapsed >= gameState.maxTime) return finishGame('Estrella de Rock');
    }

    // 4. Renderizar partículas
    renderParticles();
  }

  animFrameId = requestAnimationFrame(runGameLoop);
}

function spawnParticles(x, y, color) {
  for (let i = 0; i < 12; i++) {
    gameState.particles.push({
      x, y,
      vx: (Math.random() - 0.5) * 6,
      vy: (Math.random() - 0.5) * 6,
      alpha: 1.0,
      color: color
    });
  }
}

function renderParticles() {
  gameState.particles = gameState.particles.filter(p => {
    p.x += p.vx; p.y += p.vy;
    p.alpha -= 0.04;
    if (p.alpha <= 0) return false;
    ctx.beginPath(); ctx.arc(p.x, p.y, 4, 0, Math.PI * 2);
    ctx.fillStyle = p.color; ctx.globalAlpha = p.alpha;
    ctx.fill(); ctx.globalAlpha = 1.0;
    return true;
  });
}

function renderHUD(w, h, textL, textR) {
  ctx.fillStyle = '#ffffff'; ctx.font = 'bold 13px Fredoka, sans-serif';
  ctx.textAlign = 'left'; ctx.fillText(textL, 12, 22);
  ctx.textAlign = 'right'; ctx.fillText(textR, w - 12, 22);
}

function togglePauseGame() {
  isPaused = !isPaused;
  document.getElementById('btnPauseGame').innerText = isPaused ? '▶️' : '⏸️';
}

function stopGame(userCancelled) {
  cancelAnimationFrame(animFrameId);
  clearInterval(gameInterval);
  activeGame = null;
  document.getElementById('boxGameActive').classList.add('hidden');
  document.getElementById('boxGameMenu').classList.remove('hidden');
}

function finishGame(gameName) {
  cancelAnimationFrame(animFrameId);
  clearInterval(gameInterval);
  activeGame = null;
  playSound('win');

  const score = gameState.score;
  const d = new Date();
  const dateStr = `${String(d.getDate()).padStart(2,'0')}/${String(d.getMonth()+1).padStart(2,'0')}`;
  
  const sessionRecord = {
    date: dateStr,
    game: gameName,
    score: score
  };

  if (gameState.reactionTimes && gameState.reactionTimes.length > 0) {
    const avg = Math.round(gameState.reactionTimes.reduce((a,b)=>a+b,0) / gameState.reactionTimes.length);
    sessionRecord.avgRt = avg;
  }

  activePatient.sessions.unshift(sessionRecord);
  savePatients();

  alert(`🎉 ¡Excelente trabajo, ${activePatient.name.split(' ')[0]}!\n\nJuego: ${gameName}\nPuntaje: ${score} Puntos`);

  document.getElementById('boxGameActive').classList.add('hidden');
  document.getElementById('boxGameMenu').classList.remove('hidden');
  renderHistory();
}

function renderHistory() {
  const container = document.getElementById('patientHistoryContainer');
  if (!container || !activePatient) return;
  container.innerHTML = '';

  if (activePatient.sessions.length === 0) {
    container.innerHTML = `<div style="background:#fff; border:2px dashed var(--border-color); border-radius:14px; padding:18px; text-align:center; color:#999; font-size:13px;">¡Todavía no hay partidas jugadas!</div>`;
    return;
  }

  activePatient.sessions.slice(0, 5).forEach(s => {
    container.innerHTML += `
      <div class="history-card">
        <div>
          <b>⭐ ${s.game}</b>
          <div style="font-size:11px; color:#999;">${s.date}</div>
        </div>
        <div style="color:var(--primary); font-weight:700; font-size:15px;">
          ${s.score} Pts ${s.avgRt ? `<span style="font-size:10px; color:var(--secondary);">(${s.avgRt}ms)</span>` : ''}
        </div>
      </div>
    `;
  });
}

/* ══════════════════════════════════════════════════════════
   NAVEGACIÓN DE PANTALLAS Y PESTAÑAS
══════════════════════════════════════════════════════════ */
function navTo(screenId) {
  document.querySelectorAll('.screen, .app-layout').forEach(el => el.classList.add('hidden'));
  document.getElementById(screenId).classList.remove('hidden');
}

function switchAppTab(tab) {
  document.getElementById('viewGames').classList.toggle('hidden', tab !== 'games');
  document.getElementById('viewAuto').classList.toggle('hidden', tab !== 'auto');
  document.getElementById('viewSettings').classList.toggle('hidden', tab !== 'settings');

  document.getElementById('navBtnGames').classList.toggle('active', tab === 'games');
  document.getElementById('navBtnAuto').classList.toggle('active', tab === 'auto');
  document.getElementById('navBtnSettings').classList.toggle('active', tab === 'settings');

  if (tab === 'auto') {
    currentAppMode = 'auto';
    safeWriteBLE(bleState.L.char, 'MODE:AUTO');
    safeWriteBLE(bleState.R.char, 'MODE:AUTO');
  } else if (tab === 'games') {
    currentAppMode = 'games';
    safeWriteBLE(bleState.L.char, 'MODE:GAMES');
    safeWriteBLE(bleState.R.char, 'MODE:GAMES');
  }
}

function updateSettingsUI() {
  const pInfo = document.getElementById('settingsPatientInfo');
  if (pInfo && activePatient) {
    pInfo.innerHTML = `
      <b>Nombre:</b> ${activePatient.name}<br>
      <b>Diagnóstico:</b> ${activePatient.diag}<br>
      <b>Umbral Izquierdo:</b> ${activePatient.threshL || '--'}<br>
      <b>Umbral Derecho:</b> ${activePatient.threshR || '--'}
    `;
  }
  const bleEl = document.getElementById('settingsBleStatus');
  if (bleEl) {
    bleEl.innerHTML = `
      <b>Brazo Izquierdo:</b> ${bleState.L.connected ? '✅ Conectado' : '❌ Desconectado'}<br>
      <b>Brazo Derecho:</b> ${bleState.R.connected ? '✅ Conectado' : '❌ Desconectado'}<br>
      <b>Auto RC:</b> ${bleState.CAR.connected ? '✅ Conectado' : '⚪ No vinculado'}
    `;
  }
  // Cargar sliders con los umbrales del paciente activo
  updateSettingsSensitivity();
}

// Simulador con teclado (← Izquierda, → Derecha, ↑ Ambos)
window.addEventListener('keydown', (e) => {
  if (e.key === 'ArrowLeft')  bleState.L.val = 3200;
  if (e.key === 'ArrowRight') bleState.R.val = 3200;
  if (e.key === 'ArrowUp')   { bleState.L.val = 3200; bleState.R.val = 3200; }
  onEMGDataReceived('L', bleState.L.val);
  onEMGDataReceived('R', bleState.R.val);
});
window.addEventListener('keyup', (e) => {
  if (e.key === 'ArrowLeft')  bleState.L.val = 150;
  if (e.key === 'ArrowRight') bleState.R.val = 150;
  if (e.key === 'ArrowUp')   { bleState.L.val = 150; bleState.R.val = 150; }
  onEMGDataReceived('L', bleState.L.val);
  onEMGDataReceived('R', bleState.R.val);
});

// Inicialización
renderPatientList();
