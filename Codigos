// 
[env:esp32dev]
platform = espressif32
board = esp32dev
framework = arduino
board_build.partitions = min_spiffs.csv
//

#include <Arduino.h>
#include <BLEDevice.h>
#include <BLEServer.h>
#include <BLEUtils.h>
#include <BLE2902.h>
#include <WiFi.h>
#include <esp_now.h>
#include <esp_wifi.h>

/* ══════════════════════════════════════════════════════════
   ROBRAIN KIDS — CONTROLADOR DEL AUTO (ESP32 NORMAL)
   - Receptor ESP-NOW en Canal 1 sincronizado (<2ms latencia)
   - Servidor BLE GATT
   - Control de Puente H (L298N / DRV8833)
══════════════════════════════════════════════════════════ */

#define DEVICE_NAME         "Robrain-Car"
#define SERVICE_UUID        "6e400001-b5a3-f393-e0a9-e50e24dcca9e"
#define CHARACTERISTIC_UUID "6e400002-b5a3-f393-e0a9-e50e24dcca9e"

#define PIN_IN1 12 
#define PIN_IN2 13
#define PIN_IN3 14
#define PIN_IN4 27

#define WIFI_CHANNEL 1

typedef struct __attribute__((packed)) struct_emg_msg {
  char arm;        // 'L' o 'R'
  uint8_t active;  // 1 = activado, 0 = reposo
  uint16_t raw;    // valor analógico
  uint32_t seq;
} struct_emg_msg;

struct_emg_msg incomingData;

volatile bool leftActive = false;
volatile bool rightActive = false;
volatile unsigned long lastLeftPacket = 0;
volatile unsigned long lastRightPacket = 0;

BLEServer* pServer = NULL;
BLECharacteristic* pCharacteristic = NULL;
bool deviceConnected = false;
bool oldDeviceConnected = false;
String lastBleCmd = "STOP";
unsigned long lastBleTime = 0;

void ejecutarMotores(String cmd) {
  static String currentCmd = "";
  if (cmd == currentCmd) return;
  currentCmd = cmd;

  if (cmd == "FORWARD") {
    digitalWrite(PIN_IN1, HIGH); digitalWrite(PIN_IN2, LOW);
    digitalWrite(PIN_IN3, HIGH); digitalWrite(PIN_IN4, LOW);
    Serial.println("[AUTO] ▲ AVANZAR (Ambos brazos)");
  } 
  else if (cmd == "BACK") {
    digitalWrite(PIN_IN1, LOW); digitalWrite(PIN_IN2, HIGH);
    digitalWrite(PIN_IN3, LOW); digitalWrite(PIN_IN4, HIGH);
    Serial.println("[AUTO] ▼ RETROCEDER");
  } 
  else if (cmd == "LEFT") {
    digitalWrite(PIN_IN1, LOW);  digitalWrite(PIN_IN2, LOW);
    digitalWrite(PIN_IN3, HIGH); digitalWrite(PIN_IN4, LOW);
    Serial.println("[AUTO] ◄ GIRAR IZQUIERDA (Brazo Izq)");
  } 
  else if (cmd == "RIGHT") {
    digitalWrite(PIN_IN1, HIGH); digitalWrite(PIN_IN2, LOW);
    digitalWrite(PIN_IN3, LOW);  digitalWrite(PIN_IN4, LOW);
    Serial.println("[AUTO] ► GIRAR DERECHA (Brazo Der)");
  } 
  else {
    digitalWrite(PIN_IN1, LOW); digitalWrite(PIN_IN2, LOW);
    digitalWrite(PIN_IN3, LOW); digitalWrite(PIN_IN4, LOW);
    Serial.println("[AUTO] ■ DETENIDO");
  }
}

void OnDataRecv(const uint8_t * mac, const uint8_t *data, int len) {
  if (len == sizeof(struct_emg_msg)) {
    memcpy(&incomingData, data, sizeof(incomingData));
    
    if (incomingData.arm == 'L') {
      leftActive = (incomingData.active == 1);
      lastLeftPacket = millis();
    } 
    else if (incomingData.arm == 'R') {
      rightActive = (incomingData.active == 1);
      lastRightPacket = millis();
    }
  }
}

class ServerCallbacks: public BLEServerCallbacks {
  void onConnect(BLEServer* pServer) {
    deviceConnected = true;
    Serial.println("[BLE] Web conectada al Auto");
  }
  void onDisconnect(BLEServer* pServer) {
    deviceConnected = false;
    Serial.println("[BLE] Web desconectada del Auto");
    ejecutarMotores("STOP");
  }
};

class CharCallbacks: public BLECharacteristicCallbacks {
  void onWrite(BLECharacteristic *pChar) {
    String rxValue = pChar->getValue().c_str();
    if (rxValue.length() > 0) {
      lastBleCmd = rxValue;
      lastBleTime = millis();
      ejecutarMotores(rxValue);
    }
  }
};

void setup() {
  Serial.begin(115200);

  pinMode(PIN_IN1, OUTPUT); pinMode(PIN_IN2, OUTPUT);
  pinMode(PIN_IN3, OUTPUT); pinMode(PIN_IN4, OUTPUT);
  ejecutarMotores("STOP");

  // 1. Inicializar Wi-Fi y fijar Canal 1
  WiFi.mode(WIFI_STA);
  WiFi.disconnect();
  
  esp_wifi_set_promiscuous(true);
  esp_wifi_set_channel(WIFI_CHANNEL, WIFI_SECOND_CHAN_NONE);
  esp_wifi_set_promiscuous(false);

  if (esp_now_init() == ESP_OK) {
    Serial.println("[ESP-NOW] Receptor inicializado en Canal 1");
    esp_now_register_recv_cb(OnDataRecv);
  } else {
    Serial.println("[ESP-NOW] Error al inicializar");
  }

  // 2. Inicializar Servidor BLE
  BLEDevice::init(DEVICE_NAME);
  pServer = BLEDevice::createServer();
  pServer->setCallbacks(new ServerCallbacks());

  BLEService *pService = pServer->createService(SERVICE_UUID);

  pCharacteristic = pService->createCharacteristic(
                                         CHARACTERISTIC_UUID,
                                         BLECharacteristic::PROPERTY_READ   |
                                         BLECharacteristic::PROPERTY_WRITE  |
                                         BLECharacteristic::PROPERTY_WRITE_NR
                                       );

  pCharacteristic->addDescriptor(new BLE2902());
  pCharacteristic->setCallbacks(new CharCallbacks());
  pService->start();

  BLEAdvertising *pAdvertising = BLEDevice::getAdvertising();
  pAdvertising->addServiceUUID(SERVICE_UUID);
  pAdvertising->setScanResponse(true);
  pAdvertising->setMinPreferred(0x06);
  BLEDevice::startAdvertising();

  Serial.println("[STATUS] Robrain-Car listo en Canal 1.");
}

void loop() {
  if (!deviceConnected && oldDeviceConnected) {
    delay(200);
    pServer->startAdvertising();
    oldDeviceConnected = deviceConnected;
  }
  if (deviceConnected && !oldDeviceConnected) {
    oldDeviceConnected = deviceConnected;
  }

  unsigned long now = millis();

  // Deadman Switch: Freno de seguridad automático
  if (now - lastLeftPacket > 250)  leftActive = false;
  if (now - lastRightPacket > 250) rightActive = false;

  bool recentEspNow = (now - lastLeftPacket < 500) || (now - lastRightPacket < 500);

  if (recentEspNow) {
    if (leftActive && rightActive) {
      ejecutarMotores("FORWARD");
    } else if (leftActive) {
      ejecutarMotores("LEFT");
    } else if (rightActive) {
      ejecutarMotores("RIGHT");
    } else {
      ejecutarMotores("STOP");
    }
  } 
  else if (now - lastBleTime < 500) {
    ejecutarMotores(lastBleCmd);
  } 
  else {
    ejecutarMotores("STOP");
  }

  delay(10);
}




